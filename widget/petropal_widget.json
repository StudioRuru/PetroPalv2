{
  "_comment": "PetroPal Widgy Widget - Reference template and setup guide",
  "widget_type": "large",
  "name": "PetroPal - Gas Stations & Prices",
  "layers": [
    {
      "type": "rectangle",
      "name": "Background",
      "position": {"x": 0, "y": 0, "width": 364, "height": 170},
      "style": {
        "background_color": "#1C1C1E",
        "corner_radius": 16
      }
    },
    {
      "type": "image",
      "name": "Station Map",
      "_comment": "Use JavaScript data source (see setup step 3). Cannot use JSON endpoint for images with dynamic location.",
      "position": {"x": 4, "y": 4, "width": 356, "height": 126},
      "data_source": {
        "type": "javascript",
        "code": "See setup step 3 - paste the Map JavaScript into this layer's JS editor"
      },
      "style": {
        "corner_radius": 12
      }
    },
    {
      "type": "symbol",
      "name": "Gas Icon",
      "position": {"x": 8, "y": 134, "width": 16, "height": 16},
      "sf_symbol": "fuelpump.fill",
      "style": {
        "tint_color": "#FF9500"
      }
    },
    {
      "type": "text",
      "name": "Tomorrow Label",
      "position": {"x": 28, "y": 132, "width": 70, "height": 18},
      "text": "Tomorrow:",
      "style": {
        "font": "SF Pro",
        "font_weight": "regular",
        "font_size": 11,
        "text_color": "#8E8E93"
      }
    },
    {
      "type": "text",
      "name": "Gas Price",
      "_comment": "Use Endpoint data source, field: gas_price.display",
      "position": {"x": 96, "y": 132, "width": 80, "height": 18},
      "data_source": {
        "type": "endpoint",
        "field": "gas_price.display"
      },
      "style": {
        "font": "SF Pro",
        "font_weight": "bold",
        "font_size": 13,
        "text_color": "#FFFFFF"
      }
    },
    {
      "type": "text",
      "name": "Price Change (Red - Up)",
      "_comment": "Shows change only when price is going UP. Stack all 3 change layers at same position.",
      "position": {"x": 176, "y": 132, "width": 50, "height": 18},
      "data_source": {
        "type": "endpoint",
        "field": "gas_price.change_red"
      },
      "style": {
        "font": "SF Pro Mono",
        "font_weight": "semibold",
        "font_size": 12,
        "text_color": "#FF3B30"
      }
    },
    {
      "type": "text",
      "name": "Price Change (Green - Down)",
      "_comment": "Shows change only when price is going DOWN.",
      "position": {"x": 176, "y": 132, "width": 50, "height": 18},
      "data_source": {
        "type": "endpoint",
        "field": "gas_price.change_green"
      },
      "style": {
        "font": "SF Pro Mono",
        "font_weight": "semibold",
        "font_size": 12,
        "text_color": "#34C759"
      }
    },
    {
      "type": "text",
      "name": "Price Change (Gray - Stable)",
      "_comment": "Shows change only when price is STABLE.",
      "position": {"x": 176, "y": 132, "width": 50, "height": 18},
      "data_source": {
        "type": "endpoint",
        "field": "gas_price.change_gray"
      },
      "style": {
        "font": "SF Pro Mono",
        "font_weight": "semibold",
        "font_size": 12,
        "text_color": "#8E8E93"
      }
    },
    {
      "type": "text",
      "name": "Fuel Grade",
      "_comment": "Shows '87' or '91'. Tap to toggle between Regular and Premium.",
      "position": {"x": 306, "y": 134, "width": 24, "height": 18},
      "data_source": {
        "type": "endpoint",
        "field": "gas_price.fuel_label"
      },
      "style": {
        "font": "SF Pro Mono",
        "font_weight": "bold",
        "font_size": 12,
        "text_color": "#FF9500",
        "text_alignment": "center"
      }
    },
    {
      "type": "tap_action",
      "name": "Fuel Toggle Tap Area",
      "_comment": "In Widgy: Tap Action over the fuel grade label. Runs 'PetroPal Toggle Fuel' Shortcut.",
      "position": {"x": 300, "y": 128, "width": 36, "height": 26},
      "action": {
        "type": "run_shortcut",
        "shortcut_name": "PetroPal Toggle Fuel"
      }
    },
    {
      "type": "symbol",
      "name": "Refresh Icon",
      "_comment": "Visual only - the actual tap action is a separate Tap Action layer overlaid on this icon (see setup step 5)",
      "position": {"x": 336, "y": 134, "width": 22, "height": 22},
      "sf_symbol": "arrow.clockwise.circle.fill",
      "style": {
        "tint_color": "#48484A"
      }
    },
    {
      "type": "tap_action",
      "name": "Refresh Tap Area",
      "_comment": "In Widgy: add a Tap Action layer, position it over the refresh icon, set action to 'Reload Widget'",
      "position": {"x": 330, "y": 128, "width": 34, "height": 34},
      "action": "reload_widget"
    },
    {
      "type": "symbol",
      "name": "Pin Icon",
      "position": {"x": 8, "y": 152, "width": 16, "height": 16},
      "sf_symbol": "mappin.circle.fill",
      "style": {
        "tint_color": "#FF3B30"
      }
    },
    {
      "type": "text",
      "name": "Nearest Station",
      "_comment": "Use Endpoint data source, field: stations.nearest",
      "position": {"x": 28, "y": 150, "width": 240, "height": 18},
      "data_source": {
        "type": "endpoint",
        "field": "stations.nearest"
      },
      "style": {
        "font": "SF Pro",
        "font_weight": "regular",
        "font_size": 11,
        "text_color": "#AEAEB2"
      }
    },
    {
      "type": "text",
      "name": "Station Count",
      "_comment": "Use Endpoint data source, field: stations.count",
      "position": {"x": 260, "y": 150, "width": 70, "height": 18},
      "data_source": {
        "type": "endpoint",
        "field": "stations.count"
      },
      "text_suffix": " nearby",
      "style": {
        "font": "SF Pro",
        "font_weight": "regular",
        "font_size": 11,
        "text_color": "#8E8E93",
        "text_alignment": "right"
      }
    },
    {
      "type": "tap_action",
      "name": "Map Tap Area",
      "_comment": "In Widgy: add a Tap Action layer, position it over the map, set action to 'External Action > Open URL'",
      "position": {"x": 4, "y": 4, "width": 356, "height": 126},
      "action": {
        "type": "open_url",
        "url": "https://www.google.com/maps/search/Petro-Canada/",
        "_comment": "This opens Google Maps searching for Petro-Canada near the user's current location"
      }
    }
  ],
  "refresh_interval": 900
}
