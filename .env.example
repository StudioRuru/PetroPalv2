# Google Maps Static API Key (required for map images)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Default location (Toronto)
DEFAULT_LAT=43.6532
DEFAULT_LNG=-79.3832

# Search radius in kilometers
SEARCH_RADIUS_KM=15

# Map image dimensions
MAP_WIDTH=600
MAP_HEIGHT=400
MAP_ZOOM=11

# Gas price cache TTL in seconds (1 hour)
CACHE_TTL_SECONDS=3600

# Flask settings
FLASK_DEBUG=false
FLASK_PORT=5000
